rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Trup · Firestore Security Rules
//
// Reads are scoped to trips you're on. The one deliberate exception is a
// single-document read of `/trips/{id}`, which any signed-in user may make:
// that's the invite landing page, where someone has to see a trip before
// deciding to join it. Everything else — days, slots, proposals, stays,
// collection items, notes, to-dos — is members-only, for `get` and `list` alike.
//
// Two things worth knowing before editing, both of which cost an afternoon to
// re-learn:
//
// - A `list` rule is NOT evaluated against the documents that come back. It is
//   evaluated against the query, using a synthetic document holding only the
//   fields the query constrains. So a rule may only read a field the query
//   filters on: `where('trip_id', '==', x)` lets the rule read `trip_id`, and
//   an unfiltered `getDocs(collection(db, 'trips'))` sees an empty document and
//   is denied. That is exactly what closes the hole here, and it is also why
//   every query in `src/services/` has to be checked against its rule by hand.
// - A query's rule gets a budget of ~20 document access calls (`get`/`exists`),
//   and an `in` filter spends one per value: `where('day_id', 'in', [10 ids])`
//   costs 10 day reads plus one for the trip. Measured against the emulator —
//   16 calls pass, 21 fail. `IN_QUERY_MAX` in `src/services/` is therefore
//   load-bearing for reads, not just for Firestore's own `in` limit: raising it
//   past 19 makes the board unreadable. Documents carrying their own `trip_id`
//   take the short-circuit and cost one call for the whole query.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Membership read straight off a trip document's own data.
    function isMemberOf(tripData) {
      return tripData.get('owner_uid', '') == request.auth.uid
        || request.auth.uid in tripData.get('member_uids', []);
    }

    // Helper: true if the user is owner or in member_uids for the given trip
    function tripMember(tripId) {
      let trip = get(/databases/$(database)/documents/trips/$(tripId));
      return trip != null && isMemberOf(trip.data);
    }

    function dayTripId(dayId) {
      return get(/databases/$(database)/documents/days/$(dayId)).data.trip_id;
    }

    function slotDayId(slotId) {
      return get(/databases/$(database)/documents/slots/$(slotId)).data.day_id;
    }

    // Membership for a document that names its own trip, falling back to the
    // day it hangs off for legacy documents written before `trip_id` was set.
    function memberViaDay(data) {
      return data.get('trip_id', '') != ''
        ? tripMember(data.trip_id)
        : (data.day_id is string && tripMember(dayTripId(data.day_id)));
    }

    // As above, for proposals: trip_id, else slot → day → trip.
    function memberViaSlot(data) {
      return data.get('trip_id', '') != ''
        ? tripMember(data.trip_id)
        : (data.slot_id is string && tripMember(dayTripId(slotDayId(data.slot_id))));
    }

    // ── Users (profile per uid) ───────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // ── Trips ─────────────────────────────────────────────────────────────────
    match /trips/{tripId} {
      // One trip, by document id, for any signed-in user. This is the invite
      // flow: paste /trip/:slug, sign in, see the trip, join it. A document id
      // isn't guessable, and the slug → id step is authenticated server-side in
      // `netlify/functions/resolve-trip.ts`.
      allow get: if signedIn();

      // Listing is scoped to your own trips, which is what makes
      // `getDocs(collection(db, 'trips'))` fail. `listUserTrips` filters on
      // `owner_uid ==` and `member_uids array-contains`, so every document it
      // returns satisfies this.
      allow list: if signedIn() && isMemberOf(resource.data);

      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['name', 'slug', 'destinations', 'owner_uid', 'member_uids'])
        && request.resource.data.owner_uid == request.auth.uid
        && request.auth.uid in request.resource.data.member_uids
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.slug is string;

      allow update: if signedIn()
        && (
          (
            // A member editing the trip. Ownership and membership are pinned:
            // the only membership change a client can make is the self-join
            // below, and ownership transfer would belong in a server function.
            isMemberOf(resource.data)
            && request.resource.data.get('owner_uid', '') == resource.data.get('owner_uid', '')
            && request.resource.data.get('member_uids', []) == resource.data.get('member_uids', [])
            && request.resource.data.keys().hasAll(['name', 'slug', 'destinations'])
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 200
          )
          || (
            // Self-join: add yourself to member_uids and change nothing else.
            // The new list must contain everyone the old one did (no evicting
            // the existing members) and nobody new but the caller.
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['member_uids'])
            && request.auth.uid in request.resource.data.get('member_uids', [])
            && request.resource.data.get('member_uids', []).hasAll(resource.data.get('member_uids', []))
            && request.resource.data.get('member_uids', []).hasOnly(
                 resource.data.get('member_uids', []).concat([request.auth.uid])
               )
          )
        );

      allow delete: if false;
    }

    // ── Days ──────────────────────────────────────────────────────────────────
    match /days/{dayId} {
      allow get, list: if signedIn() && tripMember(resource.data.trip_id);
      allow delete: if signedIn() && tripMember(resource.data.trip_id);
      allow create, update: if signedIn()
        && request.resource.data.trip_id is string
        && tripMember(request.resource.data.trip_id)
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 200;
    }

    // ── Slots (trip_id on create; legacy slots resolved via day_id) ───────────
    match /slots/{slotId} {
      allow get, list: if signedIn() && memberViaDay(resource.data);
      allow delete: if signedIn() && memberViaDay(resource.data);
      // For new slots we always require trip_id on create.
      allow create: if signedIn()
        && request.resource.data.day_id is string
        && request.resource.data.trip_id is string
        && tripMember(request.resource.data.trip_id)
        && request.resource.data.status in ['open', 'proposed', 'locked'];
      // For updates, allow both modern docs (with trip_id) and legacy docs
      // where we resolve the trip via the day reference.
      allow update: if signedIn()
        && request.resource.data.day_id is string
        && request.resource.data.status in ['open', 'proposed', 'locked']
        && memberViaDay(request.resource.data);
    }

    // ── Proposals (trip_id on create; legacy proposals resolved via slot→day) ─
    match /proposals/{proposalId} {
      allow get, list: if signedIn() && memberViaSlot(resource.data);
      allow delete: if signedIn() && memberViaSlot(resource.data);
      allow create: if signedIn()
        && request.resource.data.slot_id is string
        && request.resource.data.trip_id is string
        && tripMember(request.resource.data.trip_id)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 300
        && request.resource.data.proposer_name is string
        && request.resource.data.proposer_name.size() >= 1
        && request.resource.data.proposer_name.size() <= 100
        // Identity is the uid, so a client may only claim its own. Checked only
        // when present: a tab still running the pre-migration bundle writes the
        // name alone, and refusing it would break that tab mid-deploy.
        && (
          !('proposer_uid' in request.resource.data)
          || request.resource.data.proposer_uid == request.auth.uid
        );
      allow update: if signedIn() && memberViaSlot(resource.data);
    }

    // ── Trip Notes ────────────────────────────────────────────────────────────
    match /trip_notes/{noteId} {
      allow get, list: if signedIn() && tripMember(resource.data.trip_id);
      allow delete: if signedIn() && tripMember(resource.data.trip_id);
      allow create: if signedIn()
        && request.resource.data.trip_id is string
        && tripMember(request.resource.data.trip_id)
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 5000;
      allow update: if false;
    }

    // ── Stays ─────────────────────────────────────────────────────────────────
    match /stays/{stayId} {
      allow get, list: if signedIn() && tripMember(resource.data.trip_id);
      allow create: if signedIn()
        && request.resource.data.trip_id is string
        && tripMember(request.resource.data.trip_id)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 200;
      allow update: if signedIn() && tripMember(resource.data.trip_id)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 200;
      allow delete: if signedIn() && tripMember(resource.data.trip_id);
    }

    // ── Collection items ──────────────────────────────────────────────────────
    match /collection_items/{itemId} {
      allow get, list: if signedIn() && tripMember(resource.data.trip_id);
      allow delete: if signedIn() && tripMember(resource.data.trip_id);
      allow create, update: if signedIn()
        && request.resource.data.trip_id is string
        && tripMember(request.resource.data.trip_id)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 300
        && request.resource.data.category in ['food', 'activity', 'other'];
    }

    // ── Trip to-dos ───────────────────────────────────────────────────────────
    // A shared checklist: any member can tick off or remove anyone's item.
    match /trip_todos/{todoId} {
      allow get, list: if signedIn() && tripMember(resource.data.trip_id);
      allow delete: if signedIn() && tripMember(resource.data.trip_id);
      allow create, update: if signedIn()
        && request.resource.data.trip_id is string
        && tripMember(request.resource.data.trip_id)
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.done is bool
        && request.resource.data.sort_order is number;
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
