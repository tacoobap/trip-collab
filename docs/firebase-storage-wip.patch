index 0000000..9f8d637
--- /dev/null
+++ b/storage.rules
@@ -0,0 +1,52 @@
+rules_version = '2';
+
+// ─────────────────────────────────────────────────────────────────────────────
+// Trup · Cloud Storage Rules
+//
+// Trip photos: the itinerary hero, day header photos, collection item photos.
+// Every object lives under `trips/{tripId}/`, which is what lets these rules
+// reuse the same membership test as `firestore.rules` — writes are gated on the
+// trip's own `owner_uid` / `member_uids`, not merely on holding a valid token.
+//
+// Note on reads. Images are displayed through the `?alt=media&token=…` download
+// URL stored in `image_url`, and that URL is served without consulting these
+// rules — the token is the credential. That is deliberate: it is what keeps the
+// public share link at `/i/:token` and the `og-image` link-preview card working
+// for people who are not signed in, exactly as the GitHub URLs did. The read
+// rule below therefore governs only SDK/REST reads, where member-only is the
+// right default. Tightening the *displayed* photos to members is a separate
+// change: it means minting signed URLs in `shared-trip` and `og-image`.
+// ─────────────────────────────────────────────────────────────────────────────
+
+service firebase.storage {
+  match /b/{bucket}/o {
+
+    // Mirrors `tripMember()` in firestore.rules. Storage rules may touch at most
+    // two Firestore documents per evaluation; this uses exactly two.
+    function tripMember(tripId) {
+      return request.auth != null
+        && firestore.exists(/databases/(default)/documents/trips/$(tripId))
+        && (
+          firestore.get(/databases/(default)/documents/trips/$(tripId)).data.get('owner_uid', '') == request.auth.uid
+          || request.auth.uid in firestore.get(/databases/(default)/documents/trips/$(tripId)).data.get('member_uids', [])
+        );
+    }
+
+    match /trips/{tripId}/{allPaths=**} {
+      allow read: if tripMember(tripId);
+
+      // `compressImage` caps the long edge at 3840px, which lands well under
+      // 10MB; the limit is here to stop an unbounded write, not to size photos.
+      allow create, update: if tripMember(tripId)
+        && request.resource.size < 10 * 1024 * 1024
+        && request.resource.contentType.matches('image/.*');
+
+      allow delete: if tripMember(tripId);
+    }
+
+    // Nothing else is served from this bucket.
+    match /{allPaths=**} {
+      allow read, write: if false;
+    }
+  }
+}
